# แอปต้องต่อด้วย role ที่ไม่ใช่ superuser และไม่มี BYPASSRLS
# ไม่งั้น Row Level Security ถูกข้ามและข้อมูลรั่วข้ามอู่ (แอปจะไม่ยอมเริ่มทำงานถ้าตรวจเจอ)
# สร้าง role ด้วย db/app-role.sql
DATABASE_URL=postgresql://dgl_app:apppass@localhost:5433/dgl

# เฉพาะตอนพัฒนา — หน้าสลับอู่ใช้ connection นี้อ่านรายชื่ออู่
# (ตาราง tenants มี RLS จึงอ่านรายชื่อด้วย role ของแอปไม่ได้ ซึ่งถูกต้องแล้ว)
DEV_ADMIN_DATABASE_URL=postgresql://postgres:x@localhost:5433/dgl

# พอร์ตของเซิร์ฟเวอร์ตอนรันแบบ production ในเครื่อง
# บนแพลตฟอร์ม (Render และคล้ายกัน) แพลตฟอร์มกำหนดค่านี้ให้เอง ห้ามตั้งทับ
# ถ้าไม่ตั้ง Next ใช้ 3000 — ส่วน `npm run dev` ผูกไว้ที่ 3100 อยู่แล้ว
PORT=3100
