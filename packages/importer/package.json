{
  "name": "@drivegolight/importer",
  "version": "0.1.0",
  "description": "นำเข้าไฟล์สำรองข้อมูล JSON ของ DriveGoLight! รุ่น HTML เข้า Postgres",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "import": "node dist/cli.js"
  },
  "dependencies": {
    "@drivegolight/core": "0.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dgl-import": "./dist/cli.js"
  }
}
